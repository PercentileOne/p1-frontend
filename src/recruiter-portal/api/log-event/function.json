{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["post", "options"]
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "cosmosDB",
      "direction": "out",
      "name": "outputDocument",
      "databaseName": "ExplainInterviewLogs",
      "containerName": "FlowLogs",
      "createIfNotExists": true,
      "partitionKey": "/sessionId",
      "connectionStringSetting": "COSMOS_CONNECTION_STRING"
    }
  ]
}
