{
  "routes": [
    {
      "route": "/coming-soon.html",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/watch",
      "rewrite": "/api/share-meta/watch"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.css", "/*.js"]
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".mjs": "text/javascript",
    ".css": "text/css",
    ".json": "application/json",
    ".wasm": "application/wasm"
  }
}
