{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{css,js,ico,png,svg,woff,woff2}"]
  },
  "routes": [
    {
      "route": "/shared/{token}",
      "rewrite": "/api/share-meta/{token}"
    },
    {
      "route": "/hello",
      "headers": {
        "X-Frame-Options": "",
        "Content-Security-Policy": "frame-ancestors 'self' https://www.theinterviewchair.com https://theinterviewchair.com"
      }
    }
  ],
  "globalHeaders": {
    "Cache-Control": "public, max-age=0, must-revalidate",
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff"
  }
}
