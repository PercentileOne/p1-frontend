{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{css,js,ico,png,svg,woff,woff2}"]
  },
  "routes": [
    {
      "route": "/shared/{token}",
      "rewrite": "/api/share-meta/{token}"
    }
  ],
  "globalHeaders": {
    "Cache-Control": "public, max-age=0, must-revalidate",
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff"
  }
}
