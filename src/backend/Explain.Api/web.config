<?xml version="1.0" encoding="utf-8"?>
<!--
  Base template merged into the auto-generated publish/web.config (the SDK adds the
  <aspNetCore> handler on top of this). Without this, IIS's default requestLimits
  (maxAllowedContentLength ≈ 28.6MB) rejects the interview video upload before the
  request ever reaches the app — which shows up in the browser as a misleading CORS
  error ("No Access-Control-Allow-Origin header"), not a size error, because the
  connection is reset before any response headers go out.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- 500MB — comfortable headroom for a full interview screen+audio recording -->
          <requestLimits maxAllowedContentLength="524288000" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Explain.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
