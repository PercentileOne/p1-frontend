{
  "routes": [
    {
      "route": "/login",
      "rewrite": "/login.html"
    },
    {
      "route": "/register",
      "rewrite": "/register.html"
    },
    {
      "route": "/*.{png,jpg,jpeg,svg,ico,css,js,woff,woff2}"
    },
    {
      "route": "/*",
      "redirect": "https://product.interviewme.global",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html"
  }
}
