    },
    {
      "route": "/try",
      "rewrite": "/go.html"
    },
    {
      "route": "/about",
      "rewrite": "/about.html"
    },
    {
      "route": "/fp",
      "rewrite": "/fp.html"
    },
    {
      "route": "/contact",
      "rewrite": "/contact.html"
    },
    {
      "route": "/book",
      "rewrite": "/book.html"
    },
    {
      "route": "/patent",
      "rewrite": "/patent.html"
    },
    {
      "route": "/how-we-score",
      "rewrite": "/how-we-score.html"
    },
    {
      "route": "/ways-in",
      "rewrite": "/ways-in.html"
    },
    {
      "route": "/recruiters",
      "rewrite": "/recruiters.html"
    },
    {
      "route": "/pitch-deck",
      "rewrite": "/pitch-deck.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/architecture",
      "rewrite": "/architecture.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/feed-spec",
      "rewrite": "/feed-spec.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/pricing-question",
      "rewrite": "/pricing-question.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    }
