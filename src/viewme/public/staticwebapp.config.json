  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{png,jpg,svg,ico,css,js,woff,woff2}"]
  },
  "globalHeaders": {
    "X-Frame-Options": "SAMEORIGIN",
    "X-Content-Type-Options": "nosniff"
  }
