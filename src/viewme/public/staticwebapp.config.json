{
  "routes": [
    {
      "route": "/login",
      "redirect": "https://candidate.interviewme.global/login",
      "statusCode": 302
    },
    {
      "route": "/register",
      "redirect": "https://candidate.interviewme.global/register",
      "statusCode": 302
    },
    {
      "route": "/about",
      "rewrite": "/about.html"
    },
    {
      "route": "/fp",
      "rewrite": "/fp.html"
    },
    {
      "route": "/contact",
      "rewrite": "/contact.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{png,jpg,svg,ico,css,js,woff,woff2}"]
  },
  "globalHeaders": {
    "X-Frame-Options": "SAMEORIGIN",
    "X-Content-Type-Options": "nosniff"
  }
}
