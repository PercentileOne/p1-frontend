<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="InterviewMe — Concurrent Session Load Test" enabled="true">
      <stringProp name="TestPlan.comments">Targets the three endpoints identified in docs/architecture/infrastructure-reference.html as the actual risk surface under concurrent load: /api/ai-proxy (Model Router), /api/ai/transcribe (Whisper, direct OpenAI), and /api/interviews/upload (recording + metadata). Each is its own Thread Group so they can be run individually or together, and each can be scaled independently via the User Defined Variables below.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">https://api.explain.global</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CONCURRENT_USERS" elementType="Argument">
            <stringProp name="Argument.name">CONCURRENT_USERS</stringProp>
            <stringProp name="Argument.value">${__P(users,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP_SECONDS" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP_SECONDS</stringProp>
            <stringProp name="Argument.value">${__P(rampUp,60)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LOOPS" elementType="Argument">
            <stringProp name="Argument.name">LOOPS</stringProp>
            <stringProp name="Argument.value">${__P(loops,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_TOKEN" elementType="Argument">
            <stringProp name="Argument.name">AUTH_TOKEN</stringProp>
            <stringProp name="Argument.value">${__P(authToken,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUDIO_FILE" elementType="Argument">
            <stringProp name="Argument.name">AUDIO_FILE</stringProp>
            <stringProp name="Argument.value">${__P(audioFile,sample-answer.wav)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ══════════════════════════════════════════════════════════════════
           THREAD GROUP 1 — /api/ai-proxy (Azure AI Foundry Model Router)
           Default body is deliberately CHEAP (short prompt, low max output) —
           this exercises the exact same route/auth/dispatch path a real
           session-generation call does, without paying full-session token
           cost on every iterative run. Swap in the heavier body (commented
           at the bottom of the HTTP Request) for one true-to-production run
           once the cheap pass looks healthy.
           ═══════════════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="1 — AI Proxy (Model Router)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${LOOPS}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${CONCURRENT_USERS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_UP_SECONDS}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/ai-proxy (cheap probe)" enabled="true">
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.path">${BASE_URL}/api/ai-proxy</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#10;  &quot;model&quot;: &quot;gpt-4o-mini&quot;,&#10;  &quot;temperature&quot;: 0.2,&#10;  &quot;max_tokens&quot;: 20,&#10;  &quot;messages&quot;: [&#10;    { &quot;role&quot;: &quot;system&quot;, &quot;content&quot;: &quot;Load test probe. Reply with the single word OK.&quot; },&#10;    { &quot;role&quot;: &quot;user&quot;, &quot;content&quot;: &quot;ping&quot; }&#10;  ]&#10;}&#10;&#10;&lt;!-- Heavier, production-shaped body for a true-cost dry run — swap the block above for this one, matching sessionPrepareClient's actual shape (src/frontend/src/api/aiScoring.ts): --&gt;&#10;&#10;&lt;!--&#10;{&#10;  &quot;model&quot;: &quot;gpt-4o-mini&quot;,&#10;  &quot;temperature&quot;: 0.9,&#10;  &quot;response_format&quot;: { &quot;type&quot;: &quot;json_object&quot; },&#10;  &quot;messages&quot;: [&#10;    { &quot;role&quot;: &quot;system&quot;, &quot;content&quot;: &quot;You are an AI interview preparation system. Generate a complete, personalised interview session. Return ONLY valid JSON.&quot; },&#10;    { &quot;role&quot;: &quot;user&quot;, &quot;content&quot;: &quot;Generate a complete interview session for: Job Title: Senior Software Engineer. Company: LoadTest Co. Difficulty: Standard. Return 10 questions, 2 MCQs, sarahIntro, jamesIntro, companyFacts as JSON.&quot; }&#10;  ]&#10;}&#10;--&gt;</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>

      <!-- ══════════════════════════════════════════════════════════════════
           THREAD GROUP 2 — /api/ai/transcribe (OpenAI Whisper, direct — no
           Model Router failover, see infrastructure-reference.html). Posts
           the raw bytes of sample-answer.wav as the request body, same as
           VoiceInput.tsx does with a real recorded answer.
           ═══════════════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="2 — Whisper Transcription" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${LOOPS}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${CONCURRENT_USERS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_UP_SECONDS}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">audio/wav</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/ai/transcribe" enabled="true">
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.path">${BASE_URL}/api/ai/transcribe?language=en</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
            <collectionProp name="HTTPFileArgs.files">
              <elementProp name="${AUDIO_FILE}" elementType="HTTPFileArg">
                <stringProp name="File.path">${AUDIO_FILE}</stringProp>
                <stringProp name="File.paramname"></stringProp>
                <stringProp name="File.mimetype">audio/wav</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>

      <!-- ══════════════════════════════════════════════════════════════════
           THREAD GROUP 3 — /api/interviews/upload (metadata + recording).
           Requires a real bearer token (RequireAuthorization) — set -JauthToken=
           when running, or this group's requests will all come back 401,
           which is a real, correct result (not a script bug) if left blank.
           ═══════════════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="3 — Interview Upload" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${LOOPS}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${CONCURRENT_USERS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_UP_SECONDS}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${AUTH_TOKEN}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/interviews/upload" enabled="true">
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.path">${BASE_URL}/api/interviews/upload</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="metadata" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">metadata</stringProp>
                <stringProp name="Argument.value">{&quot;candidateId&quot;:&quot;loadtest-${__threadNum}-${__time()}&quot;,&quot;interviewId&quot;:&quot;${__UUID()}&quot;,&quot;role&quot;:&quot;Load Test Role&quot;,&quot;company&quot;:&quot;LoadTest Co&quot;,&quot;overallScore&quot;:75,&quot;answers&quot;:[],&quot;mcqQuestions&quot;:[],&quot;mcqResults&quot;:[],&quot;mcqBonusPoints&quot;:0,&quot;chapters&quot;:[],&quot;candidateName&quot;:&quot;Load Test&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <boolProp name="HTTPArgument.contentType">false</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>

    </hashTree>

    <!-- Results — Aggregate Report gives p50/p90/p99 + error % per sampler, which is what
         actually matters here (average alone hides the "fine most of the time, then the
         single App Service instance chokes" pattern this test exists to catch). -->
    <ResultCollector guiclass="StatVisualizer" testclass="ResultCollector" testname="Aggregate Report" enabled="true">
      <boolProp name="ResultCollector.error_logging">false</boolProp>
      <objProp>
        <name>saveConfig</name>
        <value class="SampleSaveConfiguration">
          <time>true</time>
          <latency>true</latency>
          <timestamp>true</timestamp>
          <success>true</success>
          <label>true</label>
          <code>true</code>
          <message>true</message>
          <threadName>true</threadName>
          <dataType>true</dataType>
          <responseData>false</responseData>
          <samplerData>false</samplerData>
          <xml>false</xml>
          <fieldNames>true</fieldNames>
          <responseHeaders>false</responseHeaders>
          <requestHeaders>false</requestHeaders>
          <assertions>true</assertions>
          <subresults>true</subresults>
          <bytes>true</bytes>
        </value>
      </objProp>
      <stringProp name="filename">results/aggregate.csv</stringProp>
    </ResultCollector>
    <hashTree/>
  </hashTree>
</jmeterTestPlan>
